{
	"name": "todovscode",
	"description": "VS Code extension for highlighting TODO, FIXME, and custom tags.",
	"version": "0.0.3",
	"publisher": "r6d0",
	"repository": "https://github.com/r6d0/todovscode",
	"icon": "./todovscode_icon.png",
	"engines": {
		"vscode": "^1.100.0"
	},
	"activationEvents": [
		"onStartupFinished"
	],
	"main": "./extension.js",
	"contributes": {
		"configuration": {
			"title": "todovscode extension",
			"properties": {
				"todovscode.tags": {
					"type": "array",
					"title": "Highlighting rules",
					"items": {
						"type": "object",
						"properties": {
							"keyword": {
								"type": "string",
								"title": "Tag",
								"description": "The text to highlight"
							},
							"foreground": {
								"type": "string",
								"format": "color-hex",
								"title": "Foreground",
								"description": "The text color (HEX)",
								"default": "#ffc107cc"
							}
						}
					},
					"default": [
						{
							"tag": "TODO",
							"foreground": "#ffc107cc"
						},
						{
							"tag": "FIXME",
							"foreground": "#ff0707cc"
						}
					],
					"description": "Tags to highlight"
				}
			}
		}
	},
	"scripts": {
		"test": "jest --coverage"
	},
	"jest": {
		"coverageReporters": [
			"json-summary",
			"text",
			"lcov"
		]
	},
	"devDependencies": {
		"@types/jest": "^30.0.0",
		"@types/vscode": "^1.100.0",
		"jest": "^30.5.2"
	}
}